# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_mgmt

# Secret used to sign/derive session-related values (min 32 chars random string)
AUTH_SECRET=replace-this-with-a-long-random-string

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie lifetime in seconds (default: 7 days)
SESSION_TTL_SECONDS=604800

# Node environment
NODE_ENV=development
